# InspectAI environment configuration (copy to .env; never commit real values)

# Max upload size in bytes enforced by the API (default 8 MB)
INSPECTAI_MAX_UPLOAD_BYTES=8388608

# Agent iteration ceiling (bounded loop)
INSPECTAI_MAX_AGENT_ITERS=4

# API base URL used by the Streamlit UI when calling the remote inspection API.
# Leave unset to run the pipeline in-process (no API hop).
# INSPECTAI_API_URL=https://your-apprunner-id.us-east-1.awsapprunner.com

# ---- AWS (only needed for deployment; keep credentials OUT of source) ----
# AWS_REGION=us-east-1
# Credentials should come from an IAM role (App Runner / ECS task role),
# not from variables committed anywhere.
